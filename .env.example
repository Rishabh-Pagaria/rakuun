# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored - never commit real credentials.
#
# Rakuun is self-hosted and single-tenant: every developer runs their own
# instance with their own Supabase project, Gemini key, and Google OAuth
# clients. See SUPABASE_SETUP.md for where each value comes from.

# --- Gemini -----------------------------------------------------------------
# https://aistudio.google.com/apikey
# Used server-side only, by /api/generateEmail.
GEMINI_API_KEY=

# --- Supabase ---------------------------------------------------------------
# Supabase dashboard > Settings > API
# The URL and anon key are also baked into the Chrome extension by
# `npm run build:extension`, so they must be set before building it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: bypasses Row Level Security. Server-side only - never
# expose this to the extension, the browser, or any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
# Where the Next.js API is reachable. The extension calls this at runtime, and
# it must also appear in extension/manifest.json under host_permissions.
NEXT_PUBLIC_APP_URL=http://localhost:3000
